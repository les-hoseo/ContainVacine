  logTitle: RACHEL_LIBRARY.LOG
  engContent: "\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\r\nRACHEL
    > \uBCA8\uB77C\uC6B4... \uC81C\uAC00 \uB098\uACE0\uC790\uB780 \uACF3\uC774\uAE34
    \uD558\uC8E0.\r\nRACHEL > \uADF8\uB807\uB2E4\uACE0 \uD070 \uAC10\uC815\uC774
    \uC788\uB294 \uACF3\uC740 \uC544\uB2C8\uC5D0\uC694.\r\nRACHEL > \uB2E8\uC9C0
    \uC2DC\uC758\uD68C \uB3C4\uC11C\uAD00\uC758 \uAD00\uC7A5\uC73C\uB85C\uC11C \uC788\uB294
    \uACF3 \uC815\uB3C4\uC758 \uC778\uC2DD\uC774\uB124\uC694.\r\nRACHEL > \uB3C4\uC11C\uAD00\uC5D0
    \uC788\uC73C\uBA74 \uAC00\uB054 \uC624\uB294 \uC9C4\uC0C1\uB9CC \uBE7C\uBA74
    \uADF8\uB098\uB9C8 \uC548\uBA74\uC774 \uC788\uB294 \uC0AC\uB78C\uACFC\r\nRACHEL
    > \uD3B8\uD558\uAC8C \uCC45\uC744 \uC77D\uC744 \uC218 \uC788\uC73C\uB2C8 \uD56D\uC0C1
    \uC0C1\uC8FC\uC911\uC774\uB77C...\r\nRACHEL > \uCC28\uB77C\uB9AC \uBCA8\uB77C\uC6B4\uC774
    \uC544\uB2C8\uB77C \uB3C4\uC11C\uAD00\uC5D0 \uC0B0\uB2E4\uB294 \uB9D0\uC774 \uB9DE\uB294
    \uAC83 \uAC19\uC2B5\uB2C8\uB2E4.\r\nRACHEL > \uADF8\uACF3\uC5D0\uC11C \uBA87\uBA87
    \uCC45\uACFC \uC790\uB8CC\uB4E4\uC744 \uBD84\uC11D\uD558\uAE30\uB3C4 \uD588\uC73C\uB2C8\uAE4C\uC694.\r\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\r\n"
