  engContent: "\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\r\n<color=#904ba6>RACHEL<color>
    > \uB3C4\uC11C\uAD00...?\r\n<color=#904ba6>RACHEL<color> > \uADF8\uB798, \uB9DE\uC544\uC694!\r\n<color=#904ba6>RACHEL<color>
