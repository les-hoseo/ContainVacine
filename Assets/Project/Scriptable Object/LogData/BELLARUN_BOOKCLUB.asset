  engContent: "\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\r\n[
    C.C.L.C. : CITY COUNCIL LIBRARY CLUB ]  \r\n\u2014 BELLARUN PUBLIC OUTREACH BOARD
    \u2014\r\n\r\nThe C.C.L.C. (City Council Library Club) invites you to join our\r\nweekly
    reading and discussion sessions,\r\nheld at the 3rd floor Archive Lounge of the
    Bellarun City Council Library.\r\n\r\n\u203BTopics\r\n- Local myths & urban legends 
    \r\n- Historical rituals of the Mirelin-Bellarun Strait  \r\n- Civil oral traditions
    & folk symbols\r\n\r\n(truncated)\r\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\r\n"
  korContent: "\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\r\n[
    C.C.L.C. : \uC2DC\uC758\uD68C \uB3C4\uC11C\uAD00 \uBAA8\uC784 ]  \r\n\u2014 \uBCA8\uB77C\uC6B4
    \uD64D\uBCF4 \uAC8C\uC2DC\uD310 \u2014\r\n\r\nC.C.L.C. (\uC2DC\uC758\uD68C \uB3C4\uC11C\uAD00
    \uBAA8\uC784)\uB294 \uB2F9\uC2E0\uC744 \uC8FC\uAC04 \uB3C5\uC11C \uBC0F \uD1A0\uB860
    \uAD6C\uC131\uC6D0\uC73C\uB85C \uCD08\uB300\uD569\uB2C8\uB2E4.\r\n\uBCA8\uB77C\uB8EC
    \uC2DC\uC758\uD68C \uB3C4\uC11C\uAD00 3\uCE35\uC758 \uC544\uCE74\uC774\uBE0C
    \uB77C\uC6B4\uC9C0\uC5D0\uC11C \uAC1C\uCD5C\uB429\uB2C8\uB2E4.\r\n\r\n\u203B\uC8FC\uC81C\r\n-
    \uC9C0\uC5ED \uBBF8\uC2E0 & \uB3C4\uC2DC \uC804\uC124 \r\n- \uBBF8\uB808\uB9B0\uACFC
    \uBCA8\uB77C\uC6B4 \uAC04\uC758 \uC5ED\uC0AC\uC801 \uC758\uB840  \r\n- \uAD6C\uC804
    \uC804\uD1B5 & \uBBFC\uC18D \uC0C1\uC9D5\r\n\r\n(\uC190\uC2E4\uB428)\r\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\r"
