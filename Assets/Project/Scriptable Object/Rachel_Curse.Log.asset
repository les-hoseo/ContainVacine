    > \uBB34\uBAA8\uD55C \uC77C\uC744 \uD558\uC9C0 \uC54A\uB3C4\uB85D \uD558\uB294
    \uAC83\uC744 \uBAA9\uD45C\uB85C \uD55C\uB2E4\uACE0 \uBD84\uC11D\uD588\uC5C8\uC2B5\uB2C8\uB2E4.\r\n<color=#904ba6>RACHEL</color>
