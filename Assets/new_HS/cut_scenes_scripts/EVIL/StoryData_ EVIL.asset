  Story:
  - Name: 
    Content: 
    nameplatePanel: {fileID: 0}
    Sprite: {fileID: 1034968330699063316, guid: d45963ff5a88c3c4aaa191cb3c2ff0d0, type: 3}
    effect: 3
    animationTrigger: 
  - Name: 
    Content: "\uC5EC\uAE34... \uB3C4\uB300\uCCB4 \uBB34\uC2A8\uC77C\uC774 \uC77C\uC5B4\uB09C\uAC70\uC9C0?"
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
    Sprite: {fileID: 1034968330699063316, guid: d45963ff5a88c3c4aaa191cb3c2ff0d0, type: 3}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uC5ED\uC2DC \uB0B4\uAC00 \uC798\uBABB \uB4E4\uC5C8\uB358\uAC8C \uC544\uB2C8\uC600\uC5B4,
      \uBB34\uC2A8 \uC77C\uC778\uC9C0\uB294 \uBAB0\uB77C\uB3C4\n\uBD84\uBA85\uD788...
      \uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB09C\uAC70\uC57C."
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
    Sprite: {fileID: 1034968330699063316, guid: d45963ff5a88c3c4aaa191cb3c2ff0d0, type: 3}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uADF8 \uB140\uC11D\uC744 \uCC3E\uC544\uC57C\uD574."
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uB098\uB294 \uADF8\uB300\uB85C \uB6F0\uC5C8\uB2E4. \uB208\uC5D0 \uBCF4\uC774\uB294
      \uAC83 \uC5C6\uC774 \uAC00\uB2A5\uD55C \uBA40\uB9AC, \uC774 \uCC38\uC0C1\uC774
      \uD37C\uC9C0\uC9C0 \uC54A\uC558\uC744 \uACF3\uAE4C\uC9C0."
    nameplatePanel: {fileID: 0}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uD558\uC9C0\uB9CC \uC774 \uC9C0\uC625 \uC18D\uC5D0\uC11C \uC548\uC2DD\uC774\uB780
      \uC5C6\uC5C8\uB2E4."
    nameplatePanel: {fileID: 0}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uADF8\uB140\uC11D\uC740 \uB3C4\uB300\uCCB4 \uC5B4\uB51C \uAC04\uAC70\uC57C!
      \uBC29\uC548\uC5D0 \uD2C0\uC5B4\uBC15\uD78C\uB2E4\uACE0 \uB9D0\uD55C\uAC8C"
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "10\uBD84\uB3C4 \uC548 \uC9C0\uB0AC\uB294\uB370 \uB3C4\uB300\uCCB4 \uC5B4\uB514\uB85C..."
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uBD88\uD604\uB4EF \uC88B\uC9C0\uC54A\uC740 \uC0DD\uAC01\uC774 \uC2A4\uCCE4\uB2E4."
    nameplatePanel: {fileID: 0}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uC774\uBBF8 \uCC3E\uC744 \uC218\uB3C4, \uB3CC\uC544\uC62C \uC218\uB3C4
      \uC5C6\uB294 \uC0C1\uD0DC\uAC00 \uB418\uC5B4\uBC84\uB9B0 \uAC74 \uC544\uB2D0\uAE4C?\n\uC11C\uB298\uD558\uACE0
      \uC544\uB9BF\uD55C \uAC10\uAC01\uC774 \uB4E4\uC790 \uAE08\uBC29 \uBA38\uB9AC\uC18D\uC740
      \uC5C9\uB9DD\uC774 \uB418\uC5B4\uBC84\uB838\uB2E4."
    nameplatePanel: {fileID: 0}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uB4A4, \uB3CC\uC544."
    nameplatePanel: {fileID: 3634126072714967170, guid: ea1afbf4fabf5df4a86b7476c97c32a0, type: 3}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uC5EC\uAE30\uB97C, \uBD10."
    nameplatePanel: {fileID: 3634126072714967170, guid: ea1afbf4fabf5df4a86b7476c97c32a0, type: 3}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uAC11\uC790\uAE30 \uBA38\uB9AC\uC18D\uC5D0 \uC774\uC0C1\uD55C \uC18C\uB9AC\uAC00
      \uC6B8\uB9AC\uAE30 \uC2DC\uC791\uD588\uB2E4."
    nameplatePanel: {fileID: 0}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uBA38\uB9AC\uB97C, \uAEBE\uC5B4. \uB4A4\uB97C. \uBD10."
    nameplatePanel: {fileID: 3634126072714967170, guid: ea1afbf4fabf5df4a86b7476c97c32a0, type: 3}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uBAA9\uC18C\uB9AC\uC5D0 \uADC0, \uADC0\uC6B8\uC5EC."
    nameplatePanel: {fileID: 3634126072714967170, guid: ea1afbf4fabf5df4a86b7476c97c32a0, type: 3}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uC9C1\uAC10\uC801\uC73C\uB85C \uC808\uB300\uB85C \uB4A4\uB97C \uB3CC\uC544\uBCF4\uBA74
      \uC548\uB41C\uB2E4\uB294 \uC0DD\uAC01\uC774 \uBAB8\uC744 \uAD73\uD78C\uB2E4."
    nameplatePanel: {fileID: 0}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uADF8\uB7EC\uB098..."
    nameplatePanel: {fileID: 0}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uB4A4, \uB3CC\uC544."
    nameplatePanel: {fileID: 3634126072714967170, guid: ea1afbf4fabf5df4a86b7476c97c32a0, type: 3}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uB808\uC774\uCCBC."
    nameplatePanel: {fileID: 3634126072714967170, guid: ea1afbf4fabf5df4a86b7476c97c32a0, type: 3}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: '!'
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: 
    nameplatePanel: {fileID: 0}
    Sprite: {fileID: 4349915267927364619, guid: 716d35d89f611074b8438b5ea6d819c8, type: 3}
    effect: 1
    animationTrigger: 
  - Name: 
    Content: "\uB108\uB294... \uC124\uB9C8!"
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uADF8 \uB140\uC11D\uC758 \uBA38\uB9AC\uC5D0\uB294 \uB0A0\uAC1C\uAC00
      \uB3CB\uC544\uB0AC\uACE0, \uAE30\uC774\uD558\uAC8C \uD384\uB7ED\uC774\uBA70
      \uB098\uB97C \uBD80\uB974\uACE0 \uC788\uC5C8\uB2E4."
    nameplatePanel: {fileID: 0}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uC124\uB9C8, \uADF8\uB7F4\uB9AC\uAC00..."
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uC774\uB9AC \uC640."
    nameplatePanel: {fileID: 3634126072714967170, guid: ea1afbf4fabf5df4a86b7476c97c32a0, type: 3}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uC815\uC2E0\uC774 \uBC14\uC9DD \uB4E4\uBA70 \uB2E4\uB9AC\uC5D0 \uD798\uC774
      \uC5B5\uC9C0\uB85C \uB4E4\uC5B4\uAC14\uB2E4."
    nameplatePanel: {fileID: 0}
    Sprite: {fileID: 0}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uC774, \uC77C\uB2E8 \uB3C4\uB9DD\uAC00\uC57C\uB3FC!"
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
