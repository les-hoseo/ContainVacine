  Story:
  - lineType: 0
    Name: 
    Content: "\uC5B8\uB73B \uBCF4\uBA74 \uB098\uB294 \uC774 \uBC14\uB2E4\uB97C \uAC74\uB108\uB294
      \uC2DC\uAC04\uC774 \uADF8\uC800 \uC9C0\uB8E8\uD558\uB2E4\uB294 \uB4EF \uBCF4\uC77C
      \uC218 \uC788\uC9C0\uB9CC,\n\uADF8 \uC18D\uC5D0\uB294 \uAE30\uB300\uC640 \uB4E4\uB738,
      \uD765\uBBF8\uAC00 \uAC00\uB4DD\uD558\uB2E4. "
    nameplatePanel: {fileID: 0}
    animationTrigger: 
    Sprite: {fileID: -5750353039905602045, guid: 706d8b41783411543b6b98bc83efb3c9, type: 3}
    effect: 1
    characterSprite: {fileID: 0}
    characterEffect: 0
    choices: []
  - lineType: 0
    Name: 
    Content: "\uADF8\uB807\uAE30\uC5D0 \uC774 \uC2DC\uAC04\uC5D0\uB3C4 \uC7A0\uC774
      \uC624\uC9C0 \uC54A\uC544 \uAC78\uC74C\uC744 \uD558\uB294 \uAC83\uC774\uACA0\uC9C0."
    nameplatePanel: {fileID: 0}
    animationTrigger: 
    Sprite: {fileID: -5750353039905602045, guid: 706d8b41783411543b6b98bc83efb3c9, type: 3}
    effect: 0
    characterSprite: {fileID: 0}
    characterEffect: 0
    choices: []
  - lineType: 0
    Name: 
    Content: ...
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
    animationTrigger: 
    Sprite: {fileID: -5750353039905602045, guid: 706d8b41783411543b6b98bc83efb3c9, type: 3}
