    characterEffect: 2
    choices: []
  - lineType: 0
    Name: 
    Content: "\uC544\uBB34\uB9AC \uBC16\uC774 \uC774\uB807\uAC8C \uC5B4\uB461\uB2E4\uACE0\uB294
      \uD558\uC9C0\uB9CC \uB108\uBB34\uB098 \uC870\uC6A9\uD55C\uAC8C \uC2AC\uC2AC
      \uC2E0\uACBD\uC4F0\uC778\uB2E4."
    nameplatePanel: {fileID: 0}
    animationTrigger: 
    Sprite: {fileID: -5750353039905602045, guid: 706d8b41783411543b6b98bc83efb3c9, type: 3}
    effect: 0
    characterSprite: {fileID: -4494336587138588816, guid: b1d7f3e581352364c866cbebac432ee1, type: 3}
    characterEffect: 0
    choices: []
  - lineType: 0
    Name: 
    Content: "\uC544\uBB34\uB9AC \uADF8\uB798\uB3C4 \uADF8\uB807\uC9C0, \uC548\uC774
      \uC774\uB807\uAC8C \uC870\uC6A9\uD55C\uAC8C \uB9D0\uC774 \uB418\uB098?"
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
    animationTrigger: 
    Sprite: {fileID: -5750353039905602045, guid: 706d8b41783411543b6b98bc83efb3c9, type: 3}
    effect: 0
    characterSprite: {fileID: 21300000, guid: 141b3e2305e438345babb4a84b3b27ba, type: 3}
    characterEffect: 2
    choices: []
  - lineType: 0
    Name: 
    Content: "\uBD84\uBA85 \uC544\uAE4C\uB9CC \uD574\uB3C4 \uC544\uB798\uC5D0\uC11C
      \uCFF5\uCFF5\uD558\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB838\uB358 \uAC83 \uAC19\uC740\uB370..."
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
    animationTrigger: 
    Sprite: {fileID: -5750353039905602045, guid: 706d8b41783411543b6b98bc83efb3c9, type: 3}
    effect: 0
    characterSprite: {fileID: 21300000, guid: 141b3e2305e438345babb4a84b3b27ba, type: 3}
    characterEffect: 0
    choices: []
  - lineType: 0
    Name: 
    Content: "\uC0DD\uAC01\uD574\uBCF4\uB2C8 \uC774 \uAC11\uD310\uC740 \uC870\uD0C0\uC2E4\uB85C
      \uC774\uC5B4\uC9C0\uB294 \uAE38\uC774 \uC788\uC5C8\uB2E4."
    nameplatePanel: {fileID: 0}
    animationTrigger: 
    Sprite: {fileID: -5750353039905602045, guid: 706d8b41783411543b6b98bc83efb3c9, type: 3}
    effect: 0
    characterSprite: {fileID: 21300000, guid: 141b3e2305e438345babb4a84b3b27ba, type: 3}
    characterEffect: 0
    choices: []
  - lineType: 0
    Name: 
    Content: "\uC870\uD0C0\uC2E4 \uC7A0\uAE50 \uBD10\uB3C4... \uBB38\uC81C \uC5C6\uACA0\uC9C0?"
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
    animationTrigger: 
    Sprite: {fileID: -5750353039905602045, guid: 706d8b41783411543b6b98bc83efb3c9, type: 3}
    effect: 0
    characterSprite: {fileID: 21300000, guid: 141b3e2305e438345babb4a84b3b27ba, type: 3}
    characterEffect: 0
    choices: []
  - lineType: 0
    Name: 
    Content: "\uD638\uAE30\uC2EC\uC774 \uACE0\uC591\uC774\uB97C \uC8FD\uC778\uB2E4\uB358\uAC00."
    nameplatePanel: {fileID: 0}
