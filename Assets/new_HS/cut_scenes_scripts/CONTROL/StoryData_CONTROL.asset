  m_Name: StoryData_CONTROL
  m_EditorClassIdentifier: 
  Story:
  - lineType: 0
    Content: "\uC544\uAE4C \uC2B9\uBB34\uC6D0 \uC219\uC18C\uC5D0\uC11C \uBCF8 \uB9E4\uB274\uC5BC\uC5D0
      \uB530\uB974\uBA74 \uBA3C\uC800 \uC5EC\uAE30\uC5D0 \uC5F0\uB8CC\uB97C \uB123\uC740
      \uB4A4\uC5D0..."
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
    animationTrigger: 
    Sprite: {fileID: 21300000, guid: fed9fd07671d7e147aa1b5fc5bc94dea, type: 3}
    effect: 1
    characterSprite: {fileID: 21300000, guid: 4a28a5fb81efd524e9cac7f3783e647e, type: 3}
    characterEffect: 2
    choices: []
  - lineType: 0
    Content: "\uC870\uD0C0\uC2E4\uC5D0\uC11C \uC774 \uBC30\uC758 \uC5D4\uC9C4\uC774
      \uC791\uB3D9\uC744 \uC911\uC9C0\uD588\uB2E4\uACE0 \uC54C\uB838\uB2E4. \uB9E4\uB274\uC5BC\uC5D0
      \uB530\uB974\uBA74 \uC5D4\uC9C4\uC774 \uC7AC\uAC00\uB3D9\uC2DC \uBE44\uC0C1\uC0C1\uD669\uC774\uB77C\uBA74
      \uB2E4\uC2DC \uC6D0\uB798 \uD56D\uB85C\uB97C \uB530\uB77C\uAC00\uACA0\uC9C0."
    nameplatePanel: {fileID: 0}
    animationTrigger: 
    Sprite: {fileID: 21300000, guid: fed9fd07671d7e147aa1b5fc5bc94dea, type: 3}
    effect: 1
    characterSprite: {fileID: 21300000, guid: 4a28a5fb81efd524e9cac7f3783e647e, type: 3}
    characterEffect: 1
    choices: []
  - lineType: 0
    Content: "\uB2E4 \uB410\uB2E4! \uC774\uC81C \uC5EC\uAE30 \uBC84\uD2BC\uC744 \uB204\uB974\uBA74
      \uC5D4\uC9C4\uC774 \uC7AC\uAC00\uB3D9\uD558\uB294\uAC70\uC57C."
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
    animationTrigger: 
    Sprite: {fileID: 21300000, guid: fed9fd07671d7e147aa1b5fc5bc94dea, type: 3}
    effect: 1
    characterSprite: {fileID: 21300000, guid: 4a28a5fb81efd524e9cac7f3783e647e, type: 3}
    characterEffect: 1
    choices: []
  - lineType: 0
    Content: "\uC88B\uC544... \uC5D4\uC9C4\uC74C\uC774 \uB4E4\uB9B0\uB2E4! \uC55E\uC774
      \uB9C9\uD600\uC11C \uBCF4\uC774\uC9C0\uB294 \uC54A\uC9C0\uB9CC \uD655\uC2E4\uD788
      \uBD88\uC774 \uB4E4\uC5B4\uC654\uC5B4!"
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
    animationTrigger: 
    Sprite: {fileID: 21300000, guid: fed9fd07671d7e147aa1b5fc5bc94dea, type: 3}
    effect: 1
    characterSprite: {fileID: 21300000, guid: b8cca8357f38e3840a62a31cbfa39e5f, type: 3}
    characterEffect: 1
    choices: []
  - lineType: 0
    Content: "\uC5D4\uC9C4\uC740 \uAD49\uC74C\uC744 \uB0B4\uBA70 \uC7AC\uC2DC\uB3D9\uD588\uB2E4.
      \uD558\uC9C0\uB9CC \uC5D4\uC9C4\uC758 \uC555\uB825\uC774 \uC5B4\uB290\uC815\uB3C4
      \uC0C1\uC2B9\uD558\uB354\uB2C8..."
    nameplatePanel: {fileID: 0}
    animationTrigger: 
    Sprite: {fileID: 21300000, guid: fed9fd07671d7e147aa1b5fc5bc94dea, type: 3}
    effect: 1
    characterSprite: {fileID: 21300000, guid: b8cca8357f38e3840a62a31cbfa39e5f, type: 3}
    characterEffect: 1
    choices: []
  - lineType: 0
    Content: "\uBB50\uC57C, \uC555\uB825\uC774 \uB0B4\uB824\uAC00\uACE0 \uC788\uC796\uC544?
      \uC5D4\uC9C4\uC5D0 \uC5F0\uB8CC\uAC00 \uC644\uBCBD\uD788 \uACF5\uAE09\uB418\uC9C0
      \uC54A\uACE0 \uC788\uB294\uAC74\uAC00?"
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
    animationTrigger: 
    Sprite: {fileID: 21300000, guid: fed9fd07671d7e147aa1b5fc5bc94dea, type: 3}
    effect: 1
    characterSprite: {fileID: 21300000, guid: 0c15c588b4e6f104b8cfae237ac82327, type: 3}
    characterEffect: 1
    choices: []
  - lineType: 0
    Content: "\uC5B4\uCA54 \uC218 \uC5C6\uC9C0... \uC9C0\uC18D\uC801\uC73C\uB85C
      \uC5F0\uB8CC\uB97C \uD22C\uC785\uD574\uAC00\uBA70 \uC0C1\uD669\uC744 \uBCF4\uB294
      \uC218\uBC16\uC5D0."
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
    animationTrigger: 
    Sprite: {fileID: 21300000, guid: fed9fd07671d7e147aa1b5fc5bc94dea, type: 3}
    effect: 1
    characterSprite: {fileID: 21300000, guid: 0c15c588b4e6f104b8cfae237ac82327, type: 3}
    characterEffect: 1
    choices: []
