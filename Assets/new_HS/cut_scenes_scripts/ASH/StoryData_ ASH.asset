  Story:
  - Name: 
    Content: 
    nameplatePanel: {fileID: 0}
    Sprite: {fileID: 1034968330699063316, guid: d45963ff5a88c3c4aaa191cb3c2ff0d0, type: 3}
    effect: 3
    animationTrigger: 
  - Name: 
    Content: "\uD5C9... \uD5C9... \uC5EC\uAE30\uB294 \uC5B4\uB514\uC9C0?"
    nameplatePanel: {fileID: 122448257233878304, guid: a9e4c2589fb981045a0f7cb425643bf7, type: 3}
    Sprite: {fileID: 1034968330699063316, guid: d45963ff5a88c3c4aaa191cb3c2ff0d0, type: 3}
    effect: 3
    animationTrigger: 
  - Name: 
    Content: "\uC815\uC2E0\uC5C6\uC774 \uB3C4\uB9DD\uCCD0\uC628 \uADF8 \uB05D\uC5D0
      \uB098\uB294 \uBCF5\uB3C4\uC758 \uB05D\uC5D0 \uC774\uB974\uB800\uB2E4"
    nameplatePanel: {fileID: 0}
    Sprite: {fileID: 1034968330699063316, guid: d45963ff5a88c3c4aaa191cb3c2ff0d0, type: 3}
    effect: 3
    animationTrigger: 
  - Name: 
    Content: 
    nameplatePanel: {fileID: 0}
    Sprite: {fileID: 6660783624410144326, guid: a94a657ee1dae2b418de158f4530d5a8, type: 3}
    effect: 1
    animationTrigger: 
  - Name: 
    Content: "\uAC04\uB2E8\uD788 \uC8FD\uC5B4\uC918."
    nameplatePanel: {fileID: 3634126072714967170, guid: ea1afbf4fabf5df4a86b7476c97c32a0, type: 3}
    Sprite: {fileID: 6660783624410144326, guid: a94a657ee1dae2b418de158f4530d5a8, type: 3}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: ...!
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
    Sprite: {fileID: 6660783624410144326, guid: a94a657ee1dae2b418de158f4530d5a8, type: 3}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uB208\uC55E\uC758 \uAD11\uACBD\uC5D0 \uB180\uB77C \uADF8\uB9CC \uBC14\uB2E5\uC5D0
      \uB5A8\uC5B4\uC9C4 \uC811\uC2DC\uB97C \uBC1F\uC544\uBC84\uB838\uB2E4.\n\uC774
      \uC18C\uB9AC\uC758 \uC815\uCCB4\uB294, \uC774 \uCC38\uC0C1\uC758 \uC815\uCCB4\uB294
      \uC778\uAC04\uC774\uC5C8\uB2E4."
    nameplatePanel: {fileID: 0}
    Sprite: {fileID: 6660783624410144326, guid: a94a657ee1dae2b418de158f4530d5a8, type: 3}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uC0AC\uB78C\uBCF4\uB2E4 \uAD34\uBB3C\uC774, \uAD34\uBB3C\uBCF4\uB2E4
      \uC2DC\uCCB4\uAC00 \uB9CE\uC740 \uBC30 \uC548\uC5D0\uC11C,\n\uC0AC\uB78C\uC774
      \uB9CC\uB4E0 \uC9C0\uC625\uC774 \uD3BC\uCCD0\uC9C0\uACE0 \uC788\uC5C8\uB2E4."
    nameplatePanel: {fileID: 0}
    Sprite: {fileID: 6660783624410144326, guid: a94a657ee1dae2b418de158f4530d5a8, type: 3}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: '#&@?'
    nameplatePanel: {fileID: 3634126072714967170, guid: ea1afbf4fabf5df4a86b7476c97c32a0, type: 3}
    Sprite: {fileID: 6660783624410144326, guid: a94a657ee1dae2b418de158f4530d5a8, type: 3}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: 
    nameplatePanel: {fileID: 0}
    Sprite: {fileID: 6660783624410144326, guid: a94a657ee1dae2b418de158f4530d5a8, type: 3}
    effect: 2
    animationTrigger: 
  - Name: 
    Content: "\uBFCC\uB9AC\uCCE4\uB2E4!"
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
    Sprite: {fileID: 1034968330699063316, guid: d45963ff5a88c3c4aaa191cb3c2ff0d0, type: 3}
    effect: 3
    animationTrigger: 
  - Name: 
    Content: "\uC7A0\uC2DC\uB9CC...!"
    nameplatePanel: {fileID: 3634126072714967170, guid: ea1afbf4fabf5df4a86b7476c97c32a0, type: 3}
    Sprite: {fileID: 1034968330699063316, guid: d45963ff5a88c3c4aaa191cb3c2ff0d0, type: 3}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uB098\uB294 \uB4A4\uB3C4 \uB3CC\uC544\uBCF4\uC9C0 \uC54A\uACE0 \uB3C4\uB9DD\uCCE4\uB2E4.
      \uB530\uB77C\uC624\uB294 \uBC1C\uAC78\uC74C\uC774 \uBCBD\uC744\uD0C0\uACE0
      \uBBF8\uCE5C\uB4EF\uC774 \uC6B8\uB824\uC628\uB2E4."
    nameplatePanel: {fileID: 0}
    Sprite: {fileID: 1034968330699063316, guid: d45963ff5a88c3c4aaa191cb3c2ff0d0, type: 3}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uC0AC\uB78C\uC744 \uBCF4\uACE0\uC11C \uC774\uC815\uB3C4\uB85C \uACF5\uD3EC\uC5D0
      \uD729\uC2F8\uC778 \uC801\uC774 \uC788\uC5C8\uC744\uAE4C?"
    nameplatePanel: {fileID: 0}
    Sprite: {fileID: 1034968330699063316, guid: d45963ff5a88c3c4aaa191cb3c2ff0d0, type: 3}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uB098\uB294 \uC26C\uC9C0\uC54A\uACE0 \uBCF5\uB3C4\uB97C \uB6F0\uC5C8\uB2E4."
    nameplatePanel: {fileID: 0}
    Sprite: {fileID: 1034968330699063316, guid: d45963ff5a88c3c4aaa191cb3c2ff0d0, type: 3}
    effect: 0
    animationTrigger: 
  - Name: 
    Content: "\uB3C4\uB300\uCCB4 \uC774 \uBC30 \uC548\uC5D0\uC11C \uBB34\uC2A8 \uC77C\uC774
      \uC77C\uC5B4\uB098\uACE0 \uC788\uB294\uAC70\uC57C?!"
    nameplatePanel: {fileID: 4421309645432676817, guid: a9124a67417eaaa4b9dd93ff863af348, type: 3}
    Sprite: {fileID: 1034968330699063316, guid: d45963ff5a88c3c4aaa191cb3c2ff0d0, type: 3}
