    characterEffect: 1
    choices: []
  - lineType: 0
    Content: "\uC8FC\uBC29 \uAD6C\uC11D\uC5D0 \uBC15\uD600\uC788\uB358 \uB098\uB294
      \uBA38\uB9AC\uB97C \uB4E4\uC5B4 \uBC18\uB300\uD3B8 \uAD6C\uC11D\uC744 \uBC14\uB77C\uBD24\uB2E4.
      \uADF8\uACF3\uC5D0\uB294 \uB098\uB97C \uB611\uBC14\uB85C \uBC14\uB77C\uBCF4\uACE0
      \uC788\uB294 \uBB34\uC5B8\uAC00\uAC00 \uBC84\uD2F0\uACE0 \uC788\uC5C8\uB2E4."
    nameplatePanel: {fileID: 0}
    animationTrigger: 
    lineSounds:
    - {fileID: 8300000, guid: 0d05252b5d0b8894d94b5aea32db1bff, type: 3}
    Sprite: {fileID: 21300000, guid: bfe0aca1a31a97747bb8168b10141d0b, type: 3}
    effect: 1
    characterSprite: {fileID: 21300000, guid: 009dcdb5d4a14d94eb60645c272dcd80, type: 3}
    characterEffect: 0
    choices: []
  - lineType: 0
    Content: "\uB610 \uAD34\uBB3C\uC778\uAC00? \uC778\uAC04?"
    nameplatePanel: {fileID: 122448257233878304, guid: a9e4c2589fb981045a0f7cb425643bf7, type: 3}
    animationTrigger: 
    lineSounds: []
    Sprite: {fileID: 21300000, guid: bfe0aca1a31a97747bb8168b10141d0b, type: 3}
    effect: 1
    characterSprite: {fileID: 21300000, guid: 009dcdb5d4a14d94eb60645c272dcd80, type: 3}
    characterEffect: 0
    choices: []
  - lineType: 0
    Content: "\uC228\uC740 \uAC00\uBE60\uC9C0\uACE0 \uB208 \uC55E\uC774 \uAE5C\uAE5C\uD574\uC838\uAC04\uB2E4.
      \uB0B4 \uBA38\uB9AC\uB294 \uB354\uC774\uC0C1 \uC81C\uB300\uB85C\uB41C \uD310\uB2E8\uC744
      \uD560 \uC218 \uC5C6\uB294\uAC78\uC9C0\uB3C4 \uBAA8\uB978\uB2E4"
    nameplatePanel: {fileID: 0}
    animationTrigger: 
    lineSounds: []
    Sprite: {fileID: 21300000, guid: bfe0aca1a31a97747bb8168b10141d0b, type: 3}
    effect: 1
    characterSprite: {fileID: 21300000, guid: 009dcdb5d4a14d94eb60645c272dcd80, type: 3}
    characterEffect: 1
    choices: []
