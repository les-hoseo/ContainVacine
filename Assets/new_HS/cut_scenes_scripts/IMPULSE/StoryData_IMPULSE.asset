  Story:
  - lineType: 0
    Content: "\uAE09\uD558\uAC8C \uB3C4\uB9DD\uCCD0\uC628 \uCE74\uD398\uD14C\uB9AC\uC544...
      \uC774\uACF3\uC5D0\uB3C4 \uC5EC\uC804\uD788 \uAD34\uBB3C\uC774 \uB4DD\uC2DC\uAE00\uD558\uACE0
      \uC788\uC5C8\uB2E4."
    nameplatePanel: {fileID: 0}
    animationTrigger: 
    lineSounds: []
    Sprite: {fileID: 21300000, guid: bfe0aca1a31a97747bb8168b10141d0b, type: 3}
    effect: 1
    characterSprite: {fileID: 0}
    characterEffect: 0
    choices: []
  - lineType: 0
    Content: "\uADF8\uC800 \uD3C9\uBC94\uD558\uAC8C \uC0B4\uACE0\uC2F6\uC744 \uBFD0\uC774\uC5C8\uB294\uB370,
      \uC5B4\uCA30\uC11C...\uC5B4\uC9F8\uC11C \uC774\uB7F0\uC77C\uC774...!"
    nameplatePanel: {fileID: 122448257233878304, guid: a9e4c2589fb981045a0f7cb425643bf7, type: 3}
    animationTrigger: 
    lineSounds:
    - {fileID: 8300000, guid: 9df8ca89608d0e248b839a6bf5c683a8, type: 3}
    Sprite: {fileID: 21300000, guid: bfe0aca1a31a97747bb8168b10141d0b, type: 3}
    effect: 1
    characterSprite: {fileID: 21300000, guid: 753434425caa72245aa567a531f2c144, type: 3}
    characterEffect: 2
    choices: []
  - lineType: 0
    Content: "...\uC544\uAE4C\uBD80\uD130 \uC2EC\uC7A5\uC774 \uB108\uBB34 \uBE60\uB974\uAC8C
      \uB6F0\uC5B4\uC11C, \uC228... \uC228\uC774...\uC9C4\uC815, \uC9C4\uC815\uD558\uACE0
      \uC228\uC744 \uC26C\uC5B4\uC57C..."
    nameplatePanel: {fileID: 122448257233878304, guid: a9e4c2589fb981045a0f7cb425643bf7, type: 3}
    animationTrigger: 
    lineSounds: []
    Sprite: {fileID: 21300000, guid: bfe0aca1a31a97747bb8168b10141d0b, type: 3}
    effect: 1
    characterSprite: {fileID: 21300000, guid: 753434425caa72245aa567a531f2c144, type: 3}
    characterEffect: 1
    choices: []
  - lineType: 0
    Content: "\uBD84\uBA85 \uB098\uB294 \uC9C4\uC815\uD588\uC5B4, \uD588\uB2E4\uACE0.
      \uADF8\uB7F0\uB370... \uC65C \uC544\uC9C1\uB3C4 \uC774 \uC18C\uB9AC\uB294 \uB0A0
      \uB5A0\uB098\uC9C8 \uC54A\uB294\uAC70\uC57C?!"
    nameplatePanel: {fileID: 122448257233878304, guid: a9e4c2589fb981045a0f7cb425643bf7, type: 3}
    animationTrigger: 
    lineSounds: []
    Sprite: {fileID: 21300000, guid: bfe0aca1a31a97747bb8168b10141d0b, type: 3}
    effect: 1
    characterSprite: {fileID: 21300000, guid: 753434425caa72245aa567a531f2c144, type: 3}
    characterEffect: 1
    choices: []
  - lineType: 0
    Content: ...
