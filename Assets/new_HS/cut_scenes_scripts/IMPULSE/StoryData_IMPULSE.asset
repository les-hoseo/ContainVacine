  - lineType: 0
    Content: '!'
    nameplatePanel: {fileID: 122448257233878304, guid: a9e4c2589fb981045a0f7cb425643bf7, type: 3}
    animationTrigger: 
    lineSounds: []
    Sprite: {fileID: 21300000, guid: bfe0aca1a31a97747bb8168b10141d0b, type: 3}
