    choices: []
  - lineType: 0
    Content: "\uCC98\uC74C\uC5D0\uB294 \uADF8\uC800 \uD328\uB2C9\uD55C \uC2B9\uAC1D\uC911
      \uD558\uB098\uB85C \uC0DD\uAC01\uD588\uC73C\uB098..."
