%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3288e45d9b8705447886e9287646d4a6, type: 3}
  m_Name: StoryData_ch
  m_EditorClassIdentifier: 
  Story:
  - Name: 
    Content: "\uCE74\uD398\uD14C\uB9AC\uC544 \uD640. \uC774 \uC55E\uC5D0 \uC11C\uAE30\uAE4C\uC9C0
      \uB9CE\uC740 \uB178\uB825\uC774 \uD544\uC694\uD588\uB2E4. \uD558\uC9C0\uB9CC,
      \uC5EC\uC804\uD788 \uB450\uB835\uB2E4.\r\n \uB3C4\uAD6C\uB97C \uC4F4\uB2E4\uB294
      \uAC83. \uC77C\uBC18\uC801\uC778 \uAD34\uBB3C\uB4E4\uC740 \uADF8\uB7EC\uC9C0
      \uC54A\uC558\uB2E4."
    Sprite: {fileID: 0}
    nameplatePanel: {fileID: 0}
  - Name: 
    Content: "\uBAB8 \uC2F8\uC6C0\uC744 \uD558\uACE0, \uCE7C\uC744 \uC4F0\uB294 \uC18C\uB9AC\uAC00
      \uB4E4\uB838\uB2E4. \uAD34\uC131\uC774 \uC6B8\uB824\uD37C\uC9C0\uBA70 \uB048\uC9C8\uAE30\uAC8C
      \uC0B4\uC544\uB0A8\uC73C\uB824\uB294 \uACE0\uD1B5\uC758 \uBAB8\uBD80\uB9BC\uC774,\r\n
      \uAD34\uBB3C\uC5D0\uAC8C \uC8FD\uC5B4\uB098\uAC04 \uC0AC\uB78C\uC774\uB77C\uACE0\uB294
      \uC0DD\uAC01\uD560 \uC218 \uC5C6\uB2E4."
    Sprite: {fileID: 0}
    nameplatePanel: {fileID: 0}
  - Name: 
    Content: "...\uBC1C \uAC78\uC74C\uC744 \uC870\uAE08\uB9CC \uB354 \uC6C0\uC9C1\uC77C
      \uC218 \uC788\uB2E4\uBA74."
    Sprite: {fileID: 0}
    nameplatePanel: {fileID: 0}
  - Name: 
    Content: "\uC9C0\uAE08 \uC774 \uACF5\uD3EC\uB97C \uB9C8\uC8FC\uD560 \uC218 \uC788\uC744\uAE4C?"
    Sprite: {fileID: 0}
    nameplatePanel: {fileID: 0}
  - Name: 
    Content: "\uC81C\uBC1C...\r\n\uB098\uB3C4 \uB354\uC774\uC0C1 \uC774\uB7EC\uACE0
      \uC2F6\uC9C0 \uC54A\uC73C\uB2C8\uAE4C...\r\n\uADF8\uB7EC\uB2C8\uAE4C...\r\n"
    Sprite: {fileID: 0}
    nameplatePanel: {fileID: 5226068032330008364, guid: 8a81f36e52faaab438d5be97fd94e959, type: 3}
  - Name: 
    Content: "\uAC04\uB2E8\uD788 \uC8FD\uC5B4\uC918.\r\n"
    Sprite: {fileID: 0}
    nameplatePanel: {fileID: 5226068032330008364, guid: 8a81f36e52faaab438d5be97fd94e959, type: 3}
  - Name: 
    Content: ' ...!'
    Sprite: {fileID: 0}
    nameplatePanel: {fileID: 3903792151175462648, guid: 040067d929ee736408d430f46198e272, type: 3}
  - Name: 
    Content: "\uB208\uC55E\uC758 \uAD11\uACBD\uC5D0 \uB180\uB77C \uADF8\uB9CC \uBC14\uB2E5\uC5D0
      \uB5A8\uC5B4\uC9C4 \uC811\uC2DC\uB97C \uBC1F\uC544\uBC84\uB838\uB2E4.\r\n\uC774
      \uC18C\uB9AC\uC758 \uC815\uCCB4\uB294, \uC774 \uCC38\uC0C1\uC758 \uC815\uCCB4\uB294
      \uC778\uAC04\uC774\uC5C8\uB2E4."
    Sprite: {fileID: 0}
    nameplatePanel: {fileID: 0}
  - Name: 
    Content: "\uC0AC\uB78C\uBCF4\uB2E4 \uAD34\uBB3C\uC774, \uAD34\uBB3C\uBCF4\uB2E4
      \uC2DC\uCCB4\uAC00 \uB9CE\uC740 \uBC30 \uC548\uC5D0\uC11C,\r\n\uC0AC\uB78C\uC774
      \uB9CC\uB4E0 \uC9C0\uC625\uC774 \uD3BC\uCCD0\uC9C0\uACE0 \uC788\uC5C8\uB2E4."
    Sprite: {fileID: 0}
    nameplatePanel: {fileID: 0}
  - Name: 
    Content: "\uBFCC\uB9AC\uCCE4\uB2E4!"
    Sprite: {fileID: 0}
    nameplatePanel: {fileID: 3903792151175462648, guid: 040067d929ee736408d430f46198e272, type: 3}
  - Name: 
    Content: "\uC7A0\uC2DC\uB9CC...!"
    Sprite: {fileID: 0}
    nameplatePanel: {fileID: 5226068032330008364, guid: 8a81f36e52faaab438d5be97fd94e959, type: 3}
  - Name: 
    Content: "\uB098\uB294 \uB4A4\uB3C4 \uB3CC\uC544\uBCF4\uC9C0 \uC54A\uACE0 \uB3C4\uB9DD\uCCE4\uB2E4.
      \uB530\uB77C\uC624\uB294 \uBC1C\uAC78\uC74C\uC774 \uBCBD\uC744\uD0C0\uACE0
      \uBBF8\uCE5C\uB4EF\uC774 \uC6B8\uB824\uC628\uB2E4.\r\n\uC0AC\uB78C\uC744 \uBCF4\uACE0\uC11C
      \uC774\uC815\uB3C4\uB85C \uACF5\uD3EC\uC5D0 \uD729\uC2F8\uC778 \uC801\uC774
      \uC788\uC5C8\uC744\uAE4C?"
    Sprite: {fileID: 0}
    nameplatePanel: {fileID: 0}
  - Name: 
    Content: "\uC7A5\uC18C : \uC120\uC2E4 \uBCF5\uB3C4"
    Sprite: {fileID: 0}
    nameplatePanel: {fileID: 0}
  - Name: 
    Content: "\uB098\uB294 \uC26C\uC9C0\uC54A\uACE0 \uBCF5\uB3C4\uB97C \uB6F0\uC5C8\uB2E4."
    Sprite: {fileID: 0}
    nameplatePanel: {fileID: 0}
  - Name: 
    Content: "\uB3C4\uB300\uCCB4 \uC774 \uBC30 \uC548\uC5D0\uC11C \uBB34\uC2A8 \uC77C\uC774
      \uC77C\uC5B4\uB098\uACE0 \uC788\uB294\uAC70\uC57C?!"
    Sprite: {fileID: 0}
    nameplatePanel: {fileID: 3903792151175462648, guid: 040067d929ee736408d430f46198e272, type: 3}
