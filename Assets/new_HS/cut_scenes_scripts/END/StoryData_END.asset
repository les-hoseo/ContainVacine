  - lineType: 0
    Content: "[\uAE30\uC5B5\uC7AC\uAD6C\uC131 \uC644\uB8CC]"
    nameplatePanel: {fileID: 0}
    animationTrigger: 
    Sprite: {fileID: 703237655207243699, guid: e3188c90b5340e3428e86f86fa7413f2, type: 3}
